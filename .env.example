# ============================================================
# 🎓 COLLEGE VIDYA WHATSAPP COUNSELOR BOT & CRM — .env.example
# ============================================================

# 1. LLM Provider (Groq API Key — console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=qwen/qwen3.8-27b

# 2. Owner WhatsApp Number (for 24x7 Red Alerts, 9 PM IST Daily Reports & /commands)
OWNER_NUMBER=917982412945

# 3. CRM Dashboard Authentication (Protects https://...up.railway.app)
CRM_USERNAME=harsh
CRM_PASSWORD=change_this_strong_password
CRM_SESSION_SECRET=optional_random_32_byte_hex_secret

# 4. Server & Public URL
PORT=3000
PUBLIC_URL=https://college-vidya-bot-production.up.railway.app

# 5. Persistent Storage Paths (Railway Volume Mount)
# Recommended: Mount a Railway Volume at /data (or /app/auth_info_baileys)
DATA_DIR=/data
DB_PATH=/data/crm.db
AUTH_DIR=/data/auth_info_baileys

# 6. Incoming Message Debounce Window (ms)
DEBOUNCE_MS=8500
