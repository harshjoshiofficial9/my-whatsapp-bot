# ============================================================
# 🎓 COLLEGE VIDYA WHATSAPP COUNSELOR BOT & CRM — .env.example
# ============================================================

# 1. Locked Groq LLM Engine (console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here
LLM_MODEL=openai/gpt-oss-120b

# 2. Timezone & Server
TZ=Asia/Kolkata
PORT=3000
PUBLIC_URL=https://college-vidya-bot.onrender.com

# 3. Owner WhatsApp Number (for 24x7 Red Alerts, 9 PM IST Daily Reports & /commands)
OWNER_NUMBER=917982412945

# 4. CRM Dashboard Authentication
CRM_USERNAME=harsh
CRM_PASSWORD=change_this_strong_password
CRM_SESSION_SECRET=optional_random_32_byte_hex_secret

# 5. Render.com Persistent Disk Paths (/data in production; ./data locally)
DATA_DIR=/data
DB_PATH=/data/crm.db
AUTH_DIR=/data/auth
KNOWLEDGE_DIR=/data/knowledge_library
UPLOADS_DIR=/data/uploads

# 6. Incoming Message Debounce Window (ms)
DEBOUNCE_MS=7000
